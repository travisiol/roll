# --- chain (defaults are Robinhood Chain mainnet)
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# --- contracts. Leave ROLL empty until deployed: the site then shows the
# tables as "awaiting launch" and never invents a number.
NEXT_PUBLIC_ROLL_ADDRESS=
NEXT_PUBLIC_PYTH_ADDRESS=0x8250f4aF4B972684F7b336503E2D6dFeDeB1487a
# 1 = the site talks to MockPyth on a local node (see contracts/scripts/seed-local.ts)
NEXT_PUBLIC_PYTH_MOCK=

# --- Pyth Hermes (server-side only, never NEXT_PUBLIC_). Hermes has needed a
# key since 2026-08-26: sign up at https://pythdata.app/signup. Without it the
# site falls back to the last print stored on chain and cannot open or settle
# tables from the browser.
PYTH_API_KEY=
HERMES_URL=https://hermes.pyth.network

# --- optional
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SITE_URL=
